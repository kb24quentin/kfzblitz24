generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String? // nullable — SSO-users haben kein password
  googleId  String?  @unique // Google-Workspace sub-claim
  imageUrl  String? // Profil-Foto von Google
  role      String   @default("user") // admin, user
  active    Boolean  @default(true) // false = pending, wartet auf freigabe im intranet
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activities       Activity[]
  reminders        Reminder[]
  assignedContacts Contact[] @relation("AssignedTo")
}

model Contact {
  id              String    @id @default(cuid())
  salutation      String?   // "Herr" | "Frau"  (nullable for legacy rows; required at form level)
  firstName       String
  lastName        String
  email           String    @unique
  company         String?
  position        String?
  phone           String?
  street          String?   // Straße (ohne Hausnummer)
  houseNumber     String?   // Hausnummer inkl. Zusatz ("12a")
  zipCode         String?   // PLZ
  city            String?
  country         String?   @default("DE")  // ISO 3166 alpha-2
  notes           String?
  status          String    @default("new") // new, contacted, replied, interested, not_interested, customer
  tags            String    @default("[]")
  priority        String    @default("medium") // low, medium, high
  source          String    @default("manual") // manual, import, website
  outreach        String    @default("remote") // remote (mail), local (visit in person — exclude from campaigns)
  assignedToId    String?
  lastContactedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  assignedTo       User?             @relation("AssignedTo", fields: [assignedToId], references: [id])
  emails           Email[]
  letters          Letter[]
  replies          Reply[]
  campaignContacts CampaignContact[]
  activities       Activity[]
  reminders        Reminder[]
}

model Activity {
  id        String   @id @default(cuid())
  contactId String
  userId    String?
  type      String   // comment, status_change, call, email_sent, note, reminder_created, contact_edited
  content   String?
  oldValue  String?
  newValue  String?
  createdAt DateTime @default(now())

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id])
}

model Reminder {
  id          String   @id @default(cuid())
  contactId   String
  userId      String
  stepId      String?  // set when created by a CampaignStep (cadence)
  title       String
  description String?
  dueDate     DateTime
  status      String   @default("pending") // pending, done, overdue
  retryCount  Int      @default(0)   // Anzahl bisheriger "nicht erreicht"-Versuche (nur relevant für Anrufe)
  resolution  String?  // "reached" | "voicemail" | "wrong_number" | "not_interested" | "appointment" | "gave_up" | "manual_done"
  createdAt   DateTime @default(now())

  contact Contact       @relation(fields: [contactId], references: [id], onDelete: Cascade)
  user    User          @relation(fields: [userId], references: [id])
  step    CampaignStep? @relation(fields: [stepId], references: [id], onDelete: SetNull)
}

model Template {
  id                String   @id @default(cuid())
  name              String
  subject           String
  bodyHtml          String
  bodyText          String?
  signatureId       String?  // optional FK to a managed Signature row (email only)
  letterSignatureId String?  // optional FK to LetterSignature (letter only) — Bild-Unterschrift
  type              String   @default("email") // "email" | "letter"
  letterPs          String?  // Brief-Templates: P.S. (einzige CTA im Brief)
  variables         String   @default("[]")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  signature         Signature?       @relation(fields: [signatureId], references: [id], onDelete: SetNull)
  letterSignature   LetterSignature? @relation(fields: [letterSignatureId], references: [id], onDelete: SetNull)
  campaignsA        Campaign[] @relation("TemplateA")
  campaignsB        Campaign[] @relation("TemplateB")
  campaignsFollowUp Campaign[] @relation("FollowUpTemplate")
  campaignsLetter   Campaign[] @relation("LetterTemplate")
  stepsEmailA       CampaignStep[] @relation("StepEmailA")
  stepsEmailB       CampaignStep[] @relation("StepEmailB")
  stepsLetterA      CampaignStep[] @relation("StepLetterA")
  stepsLetterB      CampaignStep[] @relation("StepLetterB")
  emails            Email[]
  letters           Letter[]
}

model LetterSignature {
  id            String   @id @default(cuid())
  name          String   @unique   // z.B. "Christian Engert - Unterschrift"
  imageData     String   // base64 PNG data URI ("data:image/png;base64,...")
  signerName    String?  // Name der unter dem Bild gedruckt wird (default: name-Feld)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  templates     Template[]
}

model Signature {
  id        String   @id @default(cuid())
  name      String   @unique
  html      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  templates Template[]
}

model Sender {
  id        String   @id @default(cuid())
  name      String   // Display-Name — z.B. "Corinna Wagner - kfzBlitz24"
  email     String   @unique   // muss auf verifierter Resend-Domain sein
  replyTo   String?  // optional; landet als Reply-To-Header, kann eine externe Adresse sein
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campaigns Campaign[]
}

// Global-Config (single-row). Aktuell nur OB24-Modus. Wenn wir mal mehr
// system-weite Settings brauchen, hier ergänzen — bleibt ein Row.
model SystemConfig {
  id             String   @id @default("singleton")
  ob24Mode       String   @default("test")  // "test" | "live"
  updatedAt      DateTime @updatedAt
  updatedByEmail String?
}

// Kurzlebige Aktionen, die eine Re-Authentifizierung erfordern (z.B.
// OB24-Modus umschalten). Wird beim Klick angelegt, nach Google-Re-Auth
// verifiziert und ausgeführt, dann gelöscht.
model PendingAdminAction {
  id             String   @id @default(cuid())
  userEmail      String
  action         String   // "ob24-mode-toggle"
  payload        String?  // JSON — z.B. {"newMode": "live"}
  expiresAt      DateTime
  createdAt      DateTime @default(now())

  @@index([expiresAt])
}

model Campaign {
  id                 String    @id @default(cuid())
  name               String
  status             String    @default("draft")
  channels           String    @default("[\"email\"]")  // JSON-encoded: any of "email"|"letter"|"call"
  templateAId        String?   // email template (Variante A) — nullable falls kein E-Mail-Kanal
  templateBId        String?   // email template (Variante B, optional)
  letterTemplateId   String?   // Brief-Template (nur wenn Channel "letter" aktiv)
  senderId           String?   // optional; falls null → env FROM_EMAIL/FROM_NAME
  scheduledAt        DateTime? // wenn gesetzt: /api/send skippt bis Zeitpunkt erreicht
  abSplitRatio       Int       @default(50)
  sendRatePerDay     Int       @default(50)
  followUpEnabled    Boolean   @default(false)
  followUpDelayDays  Int       @default(3)
  followUpTemplateId String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  templateA        Template?         @relation("TemplateA", fields: [templateAId], references: [id])
  templateB        Template?         @relation("TemplateB", fields: [templateBId], references: [id])
  letterTemplate   Template?         @relation("LetterTemplate", fields: [letterTemplateId], references: [id])
  followUpTemplate Template?         @relation("FollowUpTemplate", fields: [followUpTemplateId], references: [id])
  sender           Sender?           @relation(fields: [senderId], references: [id], onDelete: SetNull)
  steps            CampaignStep[]
  emails           Email[]
  letters          Letter[]
  campaignContacts CampaignContact[]
}

// A step in a campaign's cadence. Steps execute in `order`, one at a time
// per contact, with configurable delays and per-channel settings.
model CampaignStep {
  id                 String   @id @default(cuid())
  campaignId         String
  order              Int      // 0-indexed; 0 = first step
  channel            String   // "email" | "letter" | "call"

  // Timing
  triggerType        String   @default("relative")  // "relative" (delayDays after previous step) | "absolute" (scheduledAt)
  delayDays          Int      @default(0)
  scheduledAt        DateTime?

  // Send-window constraints (optional). JSON: {days:[0..6], slots:[{from:"HH:MM",to:"HH:MM"}]}
  // days: 0=Sun..6=Sat. Empty/null sendWindow = anytime.
  sendWindow         String?
  maxPerDay          Int?

  // Email
  emailTemplateAId   String?
  emailTemplateBId   String?  // optional A/B
  abSplitRatio       Int?     // % to A (default 50)

  // Letter
  letterTemplateAId  String?
  letterTemplateBId  String?
  letterAbSplitRatio Int?
  letterColor        String?  // "1" (S/W) | "4" (Farbig) | null = env default

  // Call
  callNote           String?

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  campaign           Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  emailTemplateA     Template? @relation("StepEmailA",  fields: [emailTemplateAId],  references: [id], onDelete: SetNull)
  emailTemplateB     Template? @relation("StepEmailB",  fields: [emailTemplateBId],  references: [id], onDelete: SetNull)
  letterTemplateA    Template? @relation("StepLetterA", fields: [letterTemplateAId], references: [id], onDelete: SetNull)
  letterTemplateB    Template? @relation("StepLetterB", fields: [letterTemplateBId], references: [id], onDelete: SetNull)

  emails             Email[]
  letters            Letter[]
  reminders          Reminder[]
  progress           CampaignContactStep[]

  @@unique([campaignId, order])
  @@index([campaignId])
}

// Per-contact tracking of step execution — one row per (contact, step)
// once the step has fired (or been skipped) for that contact.
model CampaignContactStep {
  id                String    @id @default(cuid())
  campaignContactId String
  stepId            String
  variant           String?   // "A" | "B" for this specific step
  executedAt        DateTime?
  status            String    @default("executed") // executed | skipped
  skippedReason     String?
  createdAt         DateTime  @default(now())

  campaignContact   CampaignContact @relation(fields: [campaignContactId], references: [id], onDelete: Cascade)
  step              CampaignStep    @relation(fields: [stepId], references: [id], onDelete: Cascade)

  @@unique([campaignContactId, stepId])
}

model Letter {
  id            String    @id @default(cuid())
  campaignId    String?
  contactId     String
  templateId    String?
  stepId        String?   // set when queued by a CampaignStep (cadence)
  variant       String?   // "A" | "B" — for per-step letter A/B
  subject       String    // wird als Brief-Betreff verwendet
  body          String    // Plain-Text-Body (nach HTML-Stripping)
  color         String?   // per-letter override ("1"|"4"); null = env default
  status        String    @default("queued") // queued | sent | done | canceled | failed
  ob24JobId     Int?      // OB24 printjob id
  ob24Mode      String?   // "test" | "live"
  pages         Int?      // aus OB24-response
  amount        Float?    // EUR
  trackingCode  String?
  sentAt        DateTime?
  createdAt     DateTime  @default(now())

  campaign Campaign?     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact  Contact       @relation(fields: [contactId], references: [id], onDelete: Cascade)
  template Template?     @relation(fields: [templateId], references: [id])
  step     CampaignStep? @relation(fields: [stepId], references: [id], onDelete: SetNull)
}

model CampaignContact {
  id                String    @id @default(cuid())
  campaignId        String
  contactId         String
  variant           String?   // legacy: campaign-level variant assignment (kept for old campaigns)
  currentStepIndex  Int       @default(0)  // next step to process; equals steps.length → completed
  lastStepAt        DateTime?               // when the last step executed (base for relative-delay)
  stopped           Boolean   @default(false)
  stoppedReason     String?   // "replied" | "manual" | "completed" | "migrated"
  stoppedAt         DateTime?
  forceFireAt       DateTime? // wenn gesetzt: nächster Cron-Tick ignoriert delay + sendWindow und feuert sofort
  createdAt         DateTime  @default(now())

  campaign     Campaign              @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact      Contact               @relation(fields: [contactId], references: [id], onDelete: Cascade)
  stepProgress CampaignContactStep[]

  @@unique([campaignId, contactId])
}

model Email {
  id            String    @id @default(cuid())
  campaignId    String?
  contactId     String
  templateId    String?
  stepId        String?   // set when queued by a CampaignStep (cadence)
  variant       String?
  subject       String
  body          String
  status        String    @default("queued")
  sentAt        DateTime?
  openedAt      DateTime?
  clickedAt     DateTime?
  repliedAt     DateTime?
  resendEmailId String?
  createdAt     DateTime  @default(now())

  campaign Campaign?     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact  Contact       @relation(fields: [contactId], references: [id], onDelete: Cascade)
  template Template?     @relation(fields: [templateId], references: [id])
  step     CampaignStep? @relation(fields: [stepId], references: [id], onDelete: SetNull)
  replies  Reply[]
}

model Reply {
  id          String    @id @default(cuid())
  emailId     String
  contactId   String
  fromEmail   String
  subject     String?
  body        String
  receivedAt  DateTime  @default(now())
  status      String    @default("unread")
  ourResponse String?
  respondedAt DateTime?

  email   Email   @relation(fields: [emailId], references: [id], onDelete: Cascade)
  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
}
