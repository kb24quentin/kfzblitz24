generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/**
 * Workshop = Mandant. Alle domänen-entitäten haben workshopId FK.
 * Middleware scoped alle Queries auf session.workshopId (außer für KB24-Admin).
 */
model Workshop {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  contactEmail String
  contactPhone String?
  street       String?
  zip          String?
  city         String?
  country      String   @default("DEU")
  taxId        String? // USt-IdNr
  ownerEmail   String
  plan         String   @default("free")
  active       Boolean  @default(true)

  // Briefpapier / Corporate Identity (Phase 5+6)
  letterheadLogo     Bytes? // optionales logo für PDFs
  letterheadLogoMime String?
  brandPrimary       String? // hex-color für PDF-akzente
  brandAccent        String? // sekundär-color (z.B. für sidebar-templates)
  brandFooterText    String? // legacy freitext-footer (fallback wenn cols leer)
  footerCol1         String? // spalte 1 im 3-spalten-footer (z.B. firma+adresse)
  footerCol2         String? // spalte 2 (z.B. kontakt: tel/email/web)
  footerCol3         String? // spalte 3 (z.B. bank: iban/bic/inhaber)
  letterheadTemplate String  @default("modern-orange")
  iban               String?
  bic                String?
  bankName           String?

  // Rechnungs-nummerierung (GoBD: gapless sequence pro workshop+jahr)
  invoicePrefix      String  @default("RE-")
  invoiceNumberYear  Int?
  invoiceNumberLast  Int     @default(0)
  // Angebots-nummerierung (nicht GoBD-relevant — trotzdem gapless für ordnung)
  quotePrefix        String  @default("AN-")
  quoteNumberYear    Int?
  quoteNumberLast    Int     @default(0)

  // Preis-basics
  hourlyRateCent     Int     @default(9500) // stundenlohn in cent (95€ default)
  partsMarkupPercent Int     @default(15) // aufschlag auf einkaufspreise für teile (in %)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users        WorkshopUser[]
  customers    Customer[]
  vehicles     Vehicle[]
  appointments Appointment[]
  reminders    Reminder[]
  services     ServiceItem[]
  invoices     Invoice[]
  invoiceJournal InvoiceJournalEntry[]
  quotes       Quote[]
}

/**
 * Werkstatt-Mitarbeiter — passwort-basiert (kein SSO). Email kann beliebige domäne.
 */
model WorkshopUser {
  id                   String    @id @default(cuid())
  workshopId           String
  email                String    @unique
  name                 String
  password             String?
  role                 String    @default("mitarbeiter")
  active               Boolean   @default(true)
  passwordSetupToken   String?   @unique
  passwordSetupExpires DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  workshop     Workshop      @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  appointments Appointment[] @relation("MechanicAppointments")
  invoices     Invoice[]     @relation("InvoiceCreator")
  quotes       Quote[]       @relation("QuoteCreator")

  @@index([workshopId])
}

/**
 * KB24-Admin — Google-SSO, verwaltet werkstätten. Analog Support/Intranet.
 */
model KbAdmin {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  role      String   @default("admin")
  googleId  String?  @unique
  imageUrl  String?
  active    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/**
 * Kunde der Werkstatt (b2c oder b2b).
 */
model Customer {
  id           String   @id @default(cuid())
  workshopId   String
  type         String   @default("b2c") // 'b2c' | 'b2b'
  companyName  String?
  firstName    String?
  lastName     String?
  email        String?
  phone        String?
  street       String?
  zip          String?
  city         String?
  country      String   @default("DEU")
  taxId        String? // USt-IdNr für b2b
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workshop     Workshop      @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  vehicles     Vehicle[]
  appointments Appointment[]
  reminders    Reminder[]
  invoices     Invoice[]
  quotes       Quote[]

  @@index([workshopId])
  @@index([workshopId, lastName])
}

/**
 * Fahrzeug eines kunden. Optional aber praktisch die basis für kalender+rechnungen.
 */
model Vehicle {
  id                 String    @id @default(cuid())
  workshopId         String
  customerId         String
  licensePlate       String? // kennzeichen
  vin                String? // FIN
  brand              String? // hersteller
  model              String?
  variant            String?
  year               Int?
  hsn                String? // herstellerschlüssel
  tsn                String? // typschlüssel
  fuelType           String? // benzin|diesel|hybrid|elektro|gas
  transmission       String? // schaltung|automatik
  power              Int? // kW
  color              String?
  firstRegistration  DateTime?
  mileage            Int? // aktueller km-stand
  mileageUpdatedAt   DateTime?
  nextTuev           DateTime? // HU-fällig
  nextInspection     DateTime? // wartung fällig
  notes              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  workshop     Workshop      @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  customer     Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  appointments Appointment[]
  reminders    Reminder[]
  invoices     Invoice[]
  quotes       Quote[]

  @@index([workshopId])
  @@index([customerId])
  @@index([workshopId, licensePlate])
}

/**
 * Termin im Werkstatt-Kalender. mechanicId = welcher mitarbeiter macht es.
 */
model Appointment {
  id          String    @id @default(cuid())
  workshopId  String
  customerId  String
  vehicleId   String?
  mechanicId  String?
  title       String
  description String?
  startsAt    DateTime
  endsAt      DateTime
  status      String    @default("scheduled") // 'scheduled' | 'in_progress' | 'completed' | 'cancelled'
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workshop Workshop      @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  customer Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  vehicle  Vehicle?      @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  mechanic WorkshopUser? @relation("MechanicAppointments", fields: [mechanicId], references: [id], onDelete: SetNull)

  @@index([workshopId, startsAt])
  @@index([workshopId, mechanicId, startsAt])
}

/**
 * Kunden-Erinnerung (TÜV/Inspection/frei). Cron scannt täglich und
 * sendet mails wenn dueDate <= today + notifyDaysBefore.
 */
model Reminder {
  id                 String    @id @default(cuid())
  workshopId         String
  customerId         String
  vehicleId          String?
  type               String // 'tuev' | 'inspection' | 'oil_change' | 'custom'
  title              String
  note               String?
  dueDate            DateTime
  notifyDaysBefore   Int       @default(30)
  status             String    @default("pending") // 'pending' | 'sent' | 'dismissed'
  sentAt             DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  workshop Workshop @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  vehicle  Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)

  @@index([workshopId, status, dueDate])
}

/**
 * Service-Katalog der Werkstatt (Ölwechsel, HU, Räderwechsel, ...).
 * netPrice in cent gespeichert um float-fehler zu vermeiden.
 */
/**
 * Service-Katalog. Zwei benutzungsmodi:
 *  1. Klassisch: fester nettoPreis wird direkt genommen (netPriceCent gesetzt)
 *  2. Stundenbasiert (default für Werkstatt-arbeiten): laborHours × workshop.hourlyRate
 *     wird zur laufzeit berechnet (laborHours gesetzt, netPriceCent = 0/null-ähnlich)
 *
 * Die default-liste (siehe prisma/seed.js catalog-section) füllt für jede neue
 * werkstatt ~50 standard-Kfz-arbeiten mit laborHours ein.
 */
model ServiceItem {
  id           String   @id @default(cuid())
  workshopId   String
  category     String?  // z.B. 'Wartung' | 'Bremsen' | 'Reifen' | 'Öl/Filter' | 'Diagnose' | 'Elektrik'
  name         String
  description  String?
  laborHours   Float? // arbeitsstunden — wenn gesetzt → netPrice = laborHours × hourlyRate
  netPriceCent Int      @default(0) // fester nettopreis, wenn laborHours=null
  vatPercent   Int      @default(19)
  unit         String   @default("Stk") // 'Stk' | 'Std' | 'Pauschal'
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workshop Workshop @relation(fields: [workshopId], references: [id], onDelete: Cascade)

  @@index([workshopId, active])
  @@index([workshopId, category])
}

/**
 * Rechnung. GoBD-conform:
 *  - invoiceNumber gapless pro workshop+jahr (Workshop.invoiceNumberLast)
 *  - positions als JSON-snapshot (preise zum zeitpunkt eingefroren)
 *  - status transitions immutable-logged in InvoiceJournalEntry
 *  - draft ist noch löschbar/änderbar, ab status='sent' → nur noch storno via cancellationInvoice
 *  - cancelledById: verweist auf storno-rechnung (negative summen)
 */
model Invoice {
  id              String    @id @default(cuid())
  workshopId      String
  invoiceNumber   String    @unique
  customerId      String
  vehicleId       String?
  mileageAtIssue  Int? // km-stand zum rechnungszeitpunkt (wird auf vehicle.mileage gespiegelt)
  issuedAt        DateTime  @default(now())
  dueAt           DateTime?
  positions       Json // [{ name, description?, quantity, unit, netPriceCent, vatPercent, netTotalCent, vatTotalCent, grossTotalCent }]
  subtotalNetCent Int
  totalVatCent    Int
  totalGrossCent  Int
  status          String    @default("draft") // 'draft' | 'sent' | 'paid' | 'cancelled'
  paidAt          DateTime?
  cancelledAt     DateTime?
  cancelledById   String? // FK auf Invoice.id (storno-rechnung)
  notes           String?
  createdBy       String?
  pdfBytes        Bytes? // gecachte pdf für re-download (revisionssicher)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  workshop      Workshop              @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  customer      Customer              @relation(fields: [customerId], references: [id], onDelete: Restrict)
  vehicle       Vehicle?              @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  creator       WorkshopUser?         @relation("InvoiceCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  journalEntries InvoiceJournalEntry[]
  fromQuotes    Quote[]               @relation("QuoteConvertedToInvoice")

  @@index([workshopId, issuedAt])
  @@index([workshopId, status])
}

/**
 * Angebot — vor-rechnung, kein GoBD-zwang aber gapless-numbering für ordnung.
 * Kann in eine rechnung "convertiert" werden (via convertedToInvoiceId ref).
 */
model Quote {
  id                    String    @id @default(cuid())
  workshopId            String
  quoteNumber           String    @unique
  customerId            String
  vehicleId             String?
  mileageAtIssue        Int?
  issuedAt              DateTime  @default(now())
  validUntil            DateTime?
  positions             Json
  subtotalNetCent       Int
  totalVatCent          Int
  totalGrossCent        Int
  status                String    @default("draft") // 'draft' | 'sent' | 'accepted' | 'rejected' | 'converted' | 'expired'
  acceptedAt            DateTime?
  rejectedAt            DateTime?
  convertedAt           DateTime?
  convertedToInvoiceId  String?
  notes                 String?
  createdBy             String?
  pdfBytes              Bytes?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  workshop            Workshop      @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  customer            Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  vehicle             Vehicle?      @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  creator             WorkshopUser? @relation("QuoteCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  convertedToInvoice  Invoice?      @relation("QuoteConvertedToInvoice", fields: [convertedToInvoiceId], references: [id], onDelete: SetNull)

  @@index([workshopId, issuedAt])
  @@index([workshopId, status])
}

/**
 * GoBD-audit-trail. Immutable. Kein UPDATE/DELETE erlaubt (nur INSERT).
 */
model InvoiceJournalEntry {
  id            String   @id @default(cuid())
  workshopId    String
  invoiceId     String
  invoiceNumber String
  event         String // 'created' | 'sent' | 'paid' | 'cancelled' | 'note'
  actorId       String? // WorkshopUser.id
  actorEmail    String?
  actorName     String?
  payload       Json // snapshot der änderung / body
  createdAt     DateTime @default(now())

  workshop Workshop @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  invoice  Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([workshopId, invoiceId])
  @@index([invoiceNumber])
}
